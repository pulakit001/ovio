{
  "name": "ovio",
  "version": "1.4.7",
  "description": "Talk anywhere — real-time transcription & AI notes, local-first",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "verify:signing": "node scripts/verify-release-signing.cjs",
    "test:parakeet": "node scripts/test-parakeet.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "node-llama-cpp": "3.22.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.ovio.app",
    "productName": "Ovio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "logo.png",
      "build/icon/icon_1024.png",
      "build/icon/icon_dark_1024.png"
    ],
    "mac": {
      "icon": "build/icon/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "win": {
      "icon": "build/icon/icon.ico",
      "artifactName": "Ovio-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ovio",
      "artifactName": "Ovio-Setup.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "category": "AudioVideo",
      "artifactName": "${productName}-${arch}.${ext}",
      "maintainer": "Pulakit Bararia <pulakit001@users.noreply.github.com>",
      "synopsis": "Private, local-first transcription and AI notes",
      "description": "Real-time transcription, AI notes and a searchable recording library. Local-first, private by default.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node-llama-cpp/**",
      "**/@node-llama-cpp/**",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "electron/parakeet_server.py",
        "to": "parakeet_server.py"
      }
    ],
    "afterPack": "build/afterPack.cjs"
  }
}
